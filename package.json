{
  "name": "WebsiteBuffet",
  "version": "1.0.0",
  "description": "WebsiteBuffet System",
  "main": "server.js",
  "scripts": {
    "build": "npm run build:css",
    "prestart": "npm run build:css",
    "start": "node server.js",
    "predev": "npm run build:css",
    "dev": "node --watch server.js",
    "seed": "node seed.js",
    "test:live-ui": "node scripts/test-live-updates-ui.js",
    "test:menu-ui": "node scripts/test-menu-ui.js",
    "test:admin-workflows": "node scripts/test-admin-workflows.js",
    "test:mongo": "node scripts/test-mongo.js",
    "test:browser": "node scripts/browser-smoke-test.js",
    "start:force-dns": "node -e \"require('dns').setServers(['8.8.8.8','1.1.1.1']);require('./server.js')\"",
    "build:css": "tailwindcss -i ./public/css/tailwind.css -o ./public/css/app.css --minify && node -e \"const fs=require('fs'),p=require('postcss'),r=p.parse(fs.readFileSync('public/css/app.css','utf8'));r.walkComments(c=>c.remove());fs.writeFileSync('public/css/app.css',r.toString().trim()+'\\n')\"",
    "watch:css": "tailwindcss -i ./public/css/tailwind.css -o ./public/css/app.css --watch",
    "queues:close-stale": "node scripts/close-stale-queues.js",
    "queues:migrate-business-day": "node scripts/migrate-queue-business-day.js",
    "db:migrate-mongo": "node scripts/migrate-mongo-to-sql.js"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "daisyui": "4.12.14",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.0.2",
    "pg": "^8.23.1",
    "postcss": "^8.4.49",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "daisyui": "4.12.14",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.55.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
